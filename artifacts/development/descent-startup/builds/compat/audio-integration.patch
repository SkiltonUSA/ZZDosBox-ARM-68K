-		//Maybe also check for rhythm
-		if ( header.hardware == HW_OPL2 && regFull >= 0x1b0 && regFull <=0x1b8 && val ) {
-			header.hardware = HW_DUALOPL2;
-		}
-		Bit8u raw = ToRaw[ regMask ];
-		if ( raw == 0xff )
-			return;
-		if ( regFull & 0x100 )
-			raw |= 128;
-		AddBuf( raw, val );
-	}
-	void WriteCache( void  ) {
-		Bitu i, val;
-		/* Check the registers to add */
-		for (i = 0;i < 256;i++) {
-			val = (*cache)[ i ];
